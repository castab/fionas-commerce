# Local development values, matching compose.yaml. Export them in your shell (Gradle and
# the jar read the process environment; nothing loads this file automatically). Never
# commit real credentials.
PORT="8080"
DATABASE_JDBC_URL="jdbc:postgresql://localhost:5432/fionas"
DATABASE_USERNAME="fionas"
DATABASE_PASSWORD="fionas"
# application.conf already migrates on startup; "validate" suits a separate migration step.
MIGRATIONS_ON_STARTUP="migrate"
LOG_LEVEL="INFO"

# Exact browser origins, comma-separated. This permits login and cookie-authenticated
# mutations from the local Swagger UI at http://localhost:8080/docs.
FIONAS_TRUSTED_ORIGINS="http://localhost:8080"

# Service access tokens (required; empty intentionally fails startup). The signing key is
# fionas-commerce's own secret: the base64 of at least 32 random bytes, for example
# `openssl rand -base64 32`. It signs short-lived access tokens and is NEVER given to
# fionas-web or any other service. Services authenticate instead with a serviceId and a
# credential secret created through the staff administration API, exchanged at
# POST /auth/service/token. Use a distinct issuer per environment
# (fionas-commerce-local, fionas-commerce-staging, fionas-commerce-production).
SERVICE_TOKENS_SIGNING_KEY=""
SERVICE_TOKENS_ISSUER="fionas-commerce-local"
# Optional: access token lifetime in minutes (runtime default 15, at most 60).
# SERVICE_TOKENS_LIFETIME_MINUTES="15"

# First provisioning only. Set username, password, and display name together; a partial
# set fails startup. The empty password is an intentionally invalid placeholder: replace
# it with a strong password of at least 12 characters, then remove it after provisioning.
FIONAS_BOOTSTRAP_ADMIN_USERNAME="admin"
FIONAS_BOOTSTRAP_ADMIN_PASSWORD=""
FIONAS_BOOTSTRAP_ADMIN_DISPLAY_NAME="Administrator"
FIONAS_BOOTSTRAP_ADMIN_FIRST_NAME=""
FIONAS_BOOTSTRAP_ADMIN_LAST_NAME=""

# Build-time only: resolving io.github.castab:commerce-runtime from GitHub Packages needs a
# token with read:packages (for example `gh auth token`). Alternatively set
# GitHubPackagesUsername / GitHubPackagesPassword in ~/.gradle/gradle.properties.
GITHUB_ACTOR=""
GITHUB_TOKEN=""
