# Local development values, matching compose.yaml. Export them in your shell (Gradle and
# the jar read the process environment; nothing loads this file automatically). Never
# commit real credentials.
PORT="8080"
DATABASE_JDBC_URL="jdbc:postgresql://localhost:5432/fionas"
DATABASE_USERNAME="fionas"
DATABASE_PASSWORD="fionas"
FLYWAY_ENABLED="true"
LOG_LEVEL="INFO"

# Build-time only: resolving io.github.castab:commerce-runtime from GitHub Packages needs a
# token with read:packages (for example `gh auth token`). Alternatively set
# GitHubPackagesUsername / GitHubPackagesPassword in ~/.gradle/gradle.properties.
GITHUB_ACTOR=""
GITHUB_TOKEN=""
