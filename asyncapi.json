{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Fiona commerce events",
    "version": "3.1.0",
    "description": "Commerce owns InquiryPersisted v3: an independently meaningful initial inquiry, canonical customer, requested service and Estimate snapshot. HTTP 201 commits all business facts and the event atomically. JSONB preserves structured content, not producer whitespace or key order; publication sends the stored PostgreSQL JSONB text as UTF-8. Delivery is at least once: consumers durably deduplicate event IDs and tolerate delays, missing predecessors and out-of-order processing. Payloads contain personal and commercial data: restrict consumers and establish separate broker and PostgreSQL retention policies. Optional managed intake consumes producer-owned InquirySubmitted v1 directly. Transport diagnostics InquiryProcessingFailed v2 are independently confirmed before TERM and never assert whether business effects committed."
  },
  "defaultContentType": "application/json",
  "channels": {
    "inquiryPersistedV2": {
      "address": "fionas.events.inquiry.persisted.v2",
      "description": "Historical v2 backlog only. Preserve original destination, identity and business meaning after JSONB migration.",
      "x-jetstream-stream": "FIONAS_EVENTS",
      "messages": {
        "inquiryPersistedV2": {
          "$ref": "#/components/messages/InquiryPersistedV2"
        }
      }
    },
    "inquiryPersistedV3": {
      "address": "fionas.events.inquiry.persisted.v3",
      "description": "Existing FIONAS_EVENTS stream, subjects fionas.events.>. Operator-provisioned file storage, limits retention, default max age 30 days and duplicate window 24 hours; verify actual deployment values independently. Commerce never administers this stream.",
      "x-jetstream-stream": "FIONAS_EVENTS",
      "messages": {
        "inquiryPersistedV3": {
          "$ref": "#/components/messages/InquiryPersistedV3"
        }
      }
    },
    "inquiryProcessingFailedV1": {
      "address": "fionas.events.inquiry.processing-failed.v1",
      "description": "Historical standalone-worker diagnostics; immutable.",
      "x-jetstream-stream": "FIONAS_EVENTS",
      "messages": {
        "InquiryProcessingFailedV1": {
          "$ref": "#/components/messages/InquiryProcessingFailedV1"
        }
      }
    },
    "inquiryProcessingFailedV2": {
      "address": "fionas.events.inquiry.processing-failed.v2",
      "description": "Minimal transport diagnostic, not an authoritative business event. Confirm PubAck before TERM. Retained original may already have committed effects.",
      "x-jetstream-stream": "FIONAS_EVENTS",
      "messages": {
        "InquiryProcessingFailedV2": {
          "$ref": "#/components/messages/InquiryProcessingFailedV2"
        }
      }
    },
    "inquirySubmittedV1": {
      "address": "fionas.inquiries.submitted.v1",
      "x-jetstream-stream": "FIONAS_INQUIRIES",
      "description": "Producer contract is authoritative in castab/fionas-web/asyncapi.yaml. Ignore compatible unknown fields; validate known envelope and data, project priceRevision out, retain event UUID verbatim as command key. No duration is manufactured.",
      "messages": {
        "InquirySubmittedV1": {
          "$ref": "#/components/messages/InquirySubmittedV1"
        }
      }
    }
  },
  "operations": {
    "publishInquiryPersisted": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inquiryPersistedV3"
      },
      "description": "Publish immutable record.payloadJson UTF-8 bytes from PostgreSQL JSONB, without enrichment or reserialization. Stable UUID Nats-Msg-Id. Only a valid FIONAS_EVENTS positive-sequence PubAck confirms, including duplicate acknowledgements; runtime retries ambiguous failures. Consumers deduplicate by event UUID and own correctness under delays, restarts and out-of-order processing."
    },
    "publishHistoricalInquiryPersistedV2": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inquiryPersistedV2"
      },
      "description": "Drain existing historical v2 records unchanged using their persisted destination and JSONB content. No new v2 events."
    },
    "publishInquiryProcessingFailed": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inquiryProcessingFailedV2"
      },
      "description": "Direct confirmed JetStream publication outside any database transaction, followed by source TERM. Never uses the commerce business outbox."
    },
    "consumeInquirySubmitted": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/inquirySubmittedV1"
      },
      "description": "Bind existing inquiry-to-commerce durable without mutation; validate, invoke the shared CreateInquiry operation under configured active authorized SERVICE, then confirm input ACK after commit. Outbox success delivery proceeds independently."
    }
  },
  "components": {
    "messages": {
      "InquiryPersistedV2": {
        "name": "InquiryPersistedV2",
        "title": "Commerce committed a new inquiry and its initial Estimate",
        "correlationId": {
          "location": "$message.payload#/correlationId",
          "description": "Exact original Idempotency-Key; opaque case-sensitive text, not necessarily a UUID. Distinct from event identity."
        },
        "headers": {
          "type": "object",
          "required": [
            "Nats-Msg-Id",
            "Nats-Expected-Stream",
            "Fionas-Producer-Id",
            "Fionas-Aggregate-Type",
            "Fionas-Aggregate-Id",
            "Fionas-Aggregate-Sequence"
          ],
          "properties": {
            "Nats-Msg-Id": {
              "type": "string",
              "format": "uuid",
              "description": "Equals payload id and runtime outbox UUID, unchanged on every retry."
            },
            "Nats-Expected-Stream": {
              "type": "string",
              "enum": [
                "FIONAS_EVENTS"
              ]
            },
            "Fionas-Producer-Id": {
              "type": "string",
              "enum": [
                "fionas-commerce"
              ]
            },
            "Fionas-Aggregate-Type": {
              "type": "string",
              "enum": [
                "inquiry"
              ]
            },
            "Fionas-Aggregate-Id": {
              "type": "string",
              "format": "uuid",
              "description": "Payload data.inquiryId."
            },
            "Fionas-Aggregate-Sequence": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "description": "Runtime business sequence for (producer, inquiry, inquiryId), normally 1 for creation; distinct from the broker stream sequence."
            }
          }
        },
        "payload": {
          "$ref": "#/components/schemas/InquiryPersistedV2"
        },
        "examples": [
          {
            "payload": {
              "schemaVersion": 2,
              "type": "fionas.inquiry.persisted",
              "id": "7d4e9d50-4958-46d2-bcab-e3e921cceab7",
              "correlationId": "Case_Sensitive-key-001",
              "occurredAt": "2026-10-15T18:00:00.123456Z",
              "source": "fionas-commerce",
              "data": {
                "inquiryId": "0a6e8577-e811-487f-aa5d-3d30b74b25bd",
                "customer": {
                  "name": "Jane Doe",
                  "email": "jane@example.com"
                },
                "eventDate": "2026-12-05"
              }
            }
          }
        ],
        "description": "Historical immutable v2 events remain publishable to their stored v2 destination during backlog drainage. No v3 backfill or dual publication."
      },
