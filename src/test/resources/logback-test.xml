<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: quiet unless something is wrong. Takes precedence over logback.xml. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} level=%-5level logger=%logger{36} message=%msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
